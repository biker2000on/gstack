#!/usr/bin/env bash
# gstack-config — small host-neutral config reader/writer
set -euo pipefail

STATE_DIR="${GSTACK_STATE_ROOT:-${GSTACK_HOME:-${GSTACK_STATE_DIR:-$HOME/.gstack}}}"
CONFIG_FILE="$STATE_DIR/config.yaml"

CONFIG_HEADER='# gstack workflow configuration
# Docs: https://github.com/biker2000on/gstack
# Skill names are always namespaced as gstack-<skill>.
'

lookup_default() {
  case "$1" in
    proactive) echo "true" ;;
    routing_declined) echo "false" ;;
    telemetry) echo "off" ;;
    auto_upgrade) echo "false" ;;
    update_check) echo "true" ;;
    skill_prefix) echo "true" ;;
    checkpoint_mode) echo "explicit" ;;
    checkpoint_push) echo "false" ;;
    explain_level) echo "default" ;;
    codex_reviews) echo "enabled" ;;
    gstack_contributor) echo "false" ;;
    skip_eng_review) echo "false" ;;
    workspace_root) echo "$HOME/conductor/workspaces" ;;
    plan_tune_hooks) echo "prompt" ;;
    redact_repo_visibility) echo "" ;;
    redact_prepush_hook) echo "false" ;;
    *) echo "" ;;
  esac
}

validate_key() {
  printf '%s' "$1" | grep -qE '^[a-zA-Z0-9_]+$' || {
    echo "Error: key must contain only letters, numbers, and underscores" >&2
    exit 1
  }
}

read_value() {
  local key="$1"
  local value
  value=$(grep -E "^${key}:" "$CONFIG_FILE" 2>/dev/null | tail -1 | sed -E "s/^${key}:[[:space:]]*//" || true)
  [ -n "$value" ] && printf '%s' "$value" || lookup_default "$key"
}

write_value() {
  local key="$1" value="$2" tmp
  mkdir -p "$STATE_DIR"
  [ -f "$CONFIG_FILE" ] || printf '%s' "$CONFIG_HEADER" > "$CONFIG_FILE"
  value=$(printf '%s' "$value" | head -1)
  if grep -qE "^${key}:" "$CONFIG_FILE" 2>/dev/null; then
    tmp=$(mktemp "${CONFIG_FILE}.XXXXXX")
    awk -v k="$key" -v v="$value" 'BEGIN{done=0} $0 ~ "^" k ":" {if(!done){print k ": " v; done=1}; next} {print}' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
  else
    printf '%s: %s\n' "$key" "$value" >> "$CONFIG_FILE"
  fi
}

resolve_user_slug() {
  local slug email
  slug="${USER:-${USERNAME:-}}"
  if [ -z "$slug" ]; then
    email=$(git config user.email 2>/dev/null || true)
    [ -n "$email" ] && slug="${email%@*}"
  fi
  [ -n "$slug" ] || slug="user-$(hostname 2>/dev/null || echo local)"
  printf '%s' "$slug" | tr '[:upper:] _' '[:lower:]--' | tr -dc '[:alnum:]-'
}

KNOWN_KEYS='proactive routing_declined telemetry auto_upgrade update_check skill_prefix checkpoint_mode checkpoint_push explain_level codex_reviews gstack_contributor skip_eng_review workspace_root plan_tune_hooks redact_repo_visibility redact_prepush_hook'

case "${1:-}" in
  get)
    key="${2:?Usage: gstack-config get <key>}"
    validate_key "$key"
    read_value "$key"
    ;;
  set)
    key="${2:?Usage: gstack-config set <key> <value>}"
    value="${3:?Usage: gstack-config set <key> <value>}"
    validate_key "$key"
    [ "$key" != "skill_prefix" ] || value="true"
    if [ "$key" = "codex_reviews" ] && [ "$value" != "enabled" ] && [ "$value" != "disabled" ]; then
      echo "Error: codex_reviews must be enabled or disabled" >&2
      exit 1
    fi
    if [ "$key" = "plan_tune_hooks" ] && [ "$value" != "prompt" ] && [ "$value" != "yes" ] && [ "$value" != "no" ]; then
      echo "Error: plan_tune_hooks must be prompt, yes, or no" >&2
      exit 1
    fi
    write_value "$key" "$value"
    ;;
  list)
    [ ! -f "$CONFIG_FILE" ] || cat "$CONFIG_FILE"
    echo ""
    echo "# Active values"
    for key in $KNOWN_KEYS; do printf '  %-24s %s\n' "$key:" "$(read_value "$key")"; done
    ;;
  defaults)
    for key in $KNOWN_KEYS; do printf '  %-24s %s\n' "$key:" "$(lookup_default "$key")"; done
    ;;
  resolve-user-slug)
    resolve_user_slug
    ;;
  *)
    echo "Usage: gstack-config {get|set|list|defaults|resolve-user-slug} [key] [value]" >&2
    exit 1
    ;;
esac
